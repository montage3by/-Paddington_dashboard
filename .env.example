# Google Cloud OAuth client (created in Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Google Ads API developer token (Google Ads UI -> Tools & Settings -> API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=

# Refresh token obtained once via the OAuth consent flow (see scripts/get-refresh-token.mjs)
GOOGLE_ADS_REFRESH_TOKEN=

# The Google Ads account you want to pull data from (10 digits, no dashes)
GOOGLE_ADS_CUSTOMER_ID=

# Only required if the account above is managed under an MCC (Manager Account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
